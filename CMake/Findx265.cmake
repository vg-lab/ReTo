FIND_PACKAGE(PkgConfig)

PKG_CHECK_MODULES(PC_X265 x265)
FIND_PATH(X265_INCLUDE_DIR x265.h
	HINTS ${PC_X265_INCLUDEDIR} ${PC_X265_INCLUDE_DIRS}
	NO_DEFAULT_PATH
	)

IF(${X265_INCLUDE_DIR} STREQUAL X265_INCLUDE_DIR-NOTFOUND)
	FIND_PATH(X265_INCLUDE_DIR x265.h) #try to use default dirs...
ENDIF()

IF(${X265_INCLUDE_DIR} STREQUAL X265_INCLUDE_DIR-NOTFOUND)
	FILE(GLOB_RECURSE X265_INCLUDE_DIR "/x265*/x265.h") #last resort! , besides the directory name may be different... it's very bad anyway
	IF(NOT ${X265_INCLUDE_DIR} STREQUAL X265_INCLUDE_DIR-NOTFOUND)
		GET_FILENAME_COMPONENT(X265_INCLUDE_DIR ${X265_INCLUDE_DIR} PATH)
	ENDIF()
ENDIF()

IF(${X265_INCLUDE_DIR} STREQUAL X265_INCLUDE_DIR-NOTFOUND)
	PKG_CHECK_MODULES(PC_X265 libx265)
	FIND_PATH(X265_INCLUDE_DIR x265.h
		HINTS ${PC_X265_INCLUDEDIR} ${PC_X265_INCLUDE_DIRS}
		NO_DEFAULT_PATH)
ENDIF()

IF(${X265_INCLUDE_DIR} STREQUAL X265_INCLUDE_DIR-NOTFOUND)
	MESSAGE(STATUS "Can't find x265!")
ELSE()
	MESSAGE(STATUS "Found x265: ${X265_INCLUDE_DIR}")

	#GET_FILENAME_COMPONENT(X265_PARENT ${X265_INCLUDE_DIR} PATH)
	SET(X265_PARENT ${X265_INCLUDE_DIR})
	MESSAGE(STATUS "Using x265 dir parent as hint: ${X265_PARENT}")

	IF(NOT WIN32)
		FIND_LIBRARY(X265_LIBRARIES x265
			HINTS ${PC_X265_LIBDIR} ${PC_X265_LIBRARY_DIR} ${X265_PARENT}
			NO_DEFAULT_PATH)
		IF(${X265_LIBRARIES} STREQUAL X265_LIBRARIES-NOTFOUND)
			FIND_LIBRARY(X265_LIBRARIES libx265
				HINTS ${PC_X265_LIBDIR} ${PC_X265_LIBRARY_DIR} ${X265_PARENT}
				NO_DEFAULT_PATH)
		ENDIF()
	ELSE()
		FIND_FILE(X265_LIBRARIES NAMES libx265.lib HINTS ${X265_PARENT})
#		SET(X265_LIBRARIES "${X265_LIBRARIES}/libx265.lib")
	ENDIF()

	IF(NOT ${X265_INCLUDE_DIR} STREQUAL X265_INCLUDE_DIR-NOTFOUND
		AND NOT ${X265_LIBRARIES} STREQUAL X265_LIBRARIES-NOTFOUND)
	
		SET(X265_FOUND 1)
		SET(X265_INCLUDE_DIRS ${X265_INCLUDE_DIR})
		SET(X265_LIBS ${X265_LIBRARIES})
	
		MESSAGE(STATUS "x265 include: ${X265_INCLUDE_DIRS}")
		MESSAGE(STATUS "x265 lib: ${X265_LIBS}")
	ELSE()
		MESSAGE(STATUS "Can't find x265")
	ENDIF()
ENDIF()
