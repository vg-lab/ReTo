@PACKAGE_INIT@

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

include(CMakeFindDependencyMacro)
find_dependency(Boost CONFIG COMPONENTS unit_test_framework)
find_dependency(OpenGL)
find_dependency(GLEW)
find_dependency(Eigen3 NO_MODULE)

if(@RETO_USE_GLUT@) #RETO_USE_GLUT
  find_dependency(GLUT)
endif()
if(@RETO_USE_FREEIMAGE@) # RETO_USE_FREEIMAGE
  find_dependency(FreeImage)
endif()
if(@RETO_USE_LEXIS@) # RETO_USE_LEXIS
  find_dependency(Lexis)
endif()
if(@RETO_USE_ZEROEQ@) # RETO_USE_ZEROEQ
  find_dependency(ZeroEQ)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME_LOWER@-targets.cmake")
